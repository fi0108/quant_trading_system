# 生产环境配置
# 对应 config.production.yaml
# 注意：此文件不要提交到git

# 环境标识
ENV=production

# 数据库密码（生产环境必填）
DB_PASSWORD=your_production_db_password

# Redis密码（生产环境必填）
REDIS_PASSWORD=your_production_redis_password

# IBKR账户密码（如果需要）
# IBKR_PASSWORD=your_ibkr_password

# 邮件告警密码（生产环境告警使用）
EMAIL_PASSWORD=your_email_app_password
