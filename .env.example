# 环境变量配置模板
# 
# 使用方式：
# 1. 开发/测试环境：cp .env.dev .env（或不创建.env，直接使用.env.dev）
# 2. 生产环境：复制此文件为 .env 并填入真实密码
#
# 注意：.env 文件不会提交到git（已在.gitignore中）

# ============================================
# 生产环境配置示例
# ============================================

# 环境标识（development / production）
ENV=production

# 数据库密码（必填）
DB_PASSWORD=your_production_db_password

# Redis密码（必填）
REDIS_PASSWORD=your_production_redis_password

# IBKR账户密码（如果需要）
# IBKR_PASSWORD=your_ibkr_password

# 邮件告警密码（生产环境告警使用）
EMAIL_PASSWORD=your_email_app_password

# ============================================
# 开发/测试环境参考 .env.dev
# ============================================
